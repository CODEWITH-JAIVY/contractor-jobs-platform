# Expo me EXPO_PUBLIC_ wale variables app me chale jate hain. Is file ko .env naam se copy karo.
# Emulator: 10.0.2.2 = laptop ka localhost. Real phone: laptop ka IP (jaise http://192.168.1.5:8080)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Google Cloud Console ka WEB client ID (backend ke GOOGLE_CLIENT_ID wala same)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# AdMob ad unit IDs. Khali = Google ke test ads
EXPO_PUBLIC_BANNER_ID=
EXPO_PUBLIC_INTERSTITIAL_ID=
# Play Store link (WhatsApp share message me judta hai)
EXPO_PUBLIC_APP_LINK=
